/**
 * whisker-seabreeze.rasi
 * Tema marino suave
 */
@import "config.rasi"

* {
    /* Fondos: Azul marino profundo con opacidad suave */
    bg0:        #0d1b2ada; 
    bg1:        #1b263bda; 
    
    /* Selección: Azul agua traslúcido */
    bg-sel:     #48cae433; 

    /* Textos: Blanco azulado y cian pastel */
    fg0:        #e0f1f5; 
    fg1:        #90e0ef; 

    /* Bordes y Acentuados: Turquesa / Menta suave */
    border-col: #48cae488; 
    accent:     #52b788; 

    background-color: transparent;
    text-color:       @fg0;
    font:             "Sans 11";
}

window {
    background-color: @bg0;
    border:           1px;
    border-color:     @border-col;
    border-radius:    8px;
    padding:          10px;
}

mainbox {
    background-color: transparent;
    spacing:          10px;
}

inputbar {
    background-color: @bg1;
    border-radius:    6px;
    padding:          6px 10px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @accent;
}

entry {
    text-color:       @fg0;
    placeholder-color:@fg1;
    placeholder:      "Buscar...";
}

listbox {
    background-color: transparent;
}

listview {
    background-color: transparent;
    spacing:          4px;
    lines:            8;
}

element {
    padding:          6px 10px;
    border-radius:    4px;
    background-color: transparent;
    text-color:       @fg0;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}

element-icon {
    background-color: transparent;
    size:             20px;
}

element selected {
    background-color: @bg-sel;
    text-color:       @fg1;
    border:           1px;
    border-color:     @border-col;
}

sidebar {
    background-color: transparent;
    spacing:          4px;
}

button {
    padding:          6px 10px;
    border-radius:    4px;
    background-color: @bg1;
    text-color:       @fg0;
}

button selected {
    background-color: @bg-sel;
    text-color:       @accent;
    border:           1px;
    border-color:     @border-col;
}
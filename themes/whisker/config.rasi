/**
 * Tema rofi "whisker" - inspirado en Whisker Menu (XFCE)
 * Uso: rofi -show drun -theme whisker.rasi
 * (copiá el archivo a ~/.config/rofi/whisker.rasi)
 */

configuration {
    show-icons:          true;
    icon-theme:          "Papirus";
    display-run:         "<span foreground='#27ae60'>▶</span> Ejecutar";
    display-window:      "<span foreground='#3daee9'></span> Ventanas";
    display-filebrowser: "<span foreground='#e8912d'></span> Archivos";
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
    hover-select:        true;
}


window {
    width:            760px;
    height:           480px;
    location:         center;
    anchor:           center;
    background-color: @bg0;
    border:            1px;
    border-color:       @border-col;
    border-radius:      10px;
    padding:            0px;
}

mainbox {
    background-color: transparent;
    children:  [ inputbar, content ];
    spacing:   0px;
    padding:   0px;
}

/* --- Barra de búsqueda, arriba como en whisker --- */
inputbar {
    background-color: @bg1;
    text-color:        @fg0;
    padding:           14px 16px;
    spacing:           10px;
    children:  [ prompt, entry ];
    border:            0px 0px 1px 0px;
    border-color:      @border-col;
}

prompt {
    text-color:  @accent;
    font:        "Sans Bold 11";
    markup: true;
}

entry {
    placeholder:       "Buscar aplicaciones...";
    placeholder-color: @fg1;
    text-color:        @fg0;
}

/* --- Contenedor: sidebar + listado, como whisker --- */
content {
    orientation: horizontal;
    children:    [ sidebar, listbox ];
    spacing:     0px;
}

/* --- Sidebar vertical (a modo de "categorías") --- */
sidebar {
    orientation:       vertical;
    background-color:  @bg1;
    padding:            10px 6px;
    spacing:            4px;
    children:           [ mode-switcher ];
    border:            1px;
    border-color:       @border-col;
}

mode-switcher {
    orientation: vertical;
    /*spacing:     4px;*/
}

button {
    padding:            10px 12px;
    background-color:   transparent;
    text-color:          @fg1;
    border-radius:       6px;
    horizontal-align:    0;
    markup: true;
}

button selected {border-radius:        6px;
    background-color: @bg-sel;
    text-color:        @fg0;
}

/* --- Listado de apps, a la derecha --- */
listbox {
    orientation: vertical;
    padding:     8px;
    spacing:     0px;
    children:    [ listview ];
}

listview {
    columns:              2;
    lines:                9;
    spacing:              2px;
    fixed-height:         true;
    background-color:      transparent;
    scrollbar:             true;
    cycle:                 true;
}

scrollbar {
    width:             4px;
    handle-color:      @accent;
    handle-width:      4px;
    border-radius:     4px;
    background-color:  @bg1;
}

element {
    padding:            8px 10px;
    spacing:             10px;
    background-color:    transparent;
    text-color:           @fg0;
    border-radius:        6px;
    orientation:          horizontal;
}

element-icon {
    size:  28px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    markup: true;
}

element selected.normal {
    background-color: @bg-sel;
    text-color:        @fg0;
}

element normal.urgent,
element alternate.urgent {
    text-color: #e06c75ff;
}

element normal.active,
element alternate.active {
    text-color: @accent;
}
/*@import "themes/whisker/whisker-lcars.rasi"*/


